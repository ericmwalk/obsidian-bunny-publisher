{
  "name": "obsidian-bunny-publisher",
  "version": "1.1.0",
  "description": "Upload files from Obsidian to Bunny.net.",
  "main": "src/main.ts",
  "scripts": {
    "dev": "esbuild src/main.ts --bundle --outfile=main.js --external:obsidian --format=cjs --watch",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --outfile=main.js --external:obsidian --format=cjs --minify"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
    "esbuild": "^0.21.5",
    "obsidian": "^1.13.1",
    "tslib": "^2.4.0",
    "typescript": "^5.9.3"
  }
}
